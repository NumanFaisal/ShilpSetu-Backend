{
  "info": {
    "name": "ShilpSetu API Collection",
    "_postman_id": "shilpsetu-api-collection-v1",
    "description": "Complete Postman collection for ShilpSetu E-Commerce Marketplace API covering Artisans, Buyers, Products, Orders, AI Services, and Admin.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001",
      "type": "string"
    },
    {
      "key": "artisanToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "buyerToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Health & Diagnostics",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "02. Authentication",
      "item": [
        {
          "name": "Artisan Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('artisanToken', jsonData.token);",
                  "    console.log('Saved artisanToken:', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ramesh Kumar\",\n  \"email\": \"ramesh.artisan@example.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"artisan\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Buyer Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('buyerToken', jsonData.token);",
                  "    console.log('Saved buyerToken:', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ananya Sharma\",\n  \"email\": \"ananya.buyer@example.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"buyer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login (Sign In)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ramesh.artisan@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Send Phone OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+919876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/send-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "send-otp"]
            }
          }
        },
        {
          "name": "Verify Phone OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+919876543210\",\n  \"code\": \"1234\",\n  \"name\": \"Ramesh Kumar\",\n  \"role\": \"artisan\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "verify-otp"]
            }
          }
        }
      ]
    },
    {
      "name": "03. User & Artisan Profiles",
      "item": [
        {
          "name": "Get Current User Profile (Buyer/Seller Context)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            }
          }
        },
        {
          "name": "Update User Profile (Name/Language)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ananya Sharma (Verified Buyer)\",\n  \"language\": \"hi\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            }
          }
        },
        {
          "name": "Get My Artisan Profile & Metrics",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{artisanToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/artisans/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "artisans", "me"]
            }
          }
        },
        {
          "name": "Update Artisan Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{artisanToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeName\": \"Ramesh Blue Pottery Studio\",\n  \"bio\": \"Authentic master artisan from Jaipur with 15 years experience.\",\n  \"craftType\": \"Blue Pottery\",\n  \"location\": \"Jaipur, Rajasthan\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/artisans/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "artisans", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "04. Product Management (Seller)",
      "item": [
        {
          "name": "Create Product (Draft)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{artisanToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Handcrafted Jaipur Blue Pottery Floral Vase\",\n  \"category\": \"pottery\",\n  \"craftType\": \"Blue Pottery\",\n  \"description\": \"Traditional blue pottery floral vase crafted with quartz stone and natural glaze.\",\n  \"price\": 1850,\n  \"quantity\": 20,\n  \"material\": \"Quartz stone, glass powder, natural glaze\",\n  \"origin\": \"Jaipur, Rajasthan\",\n  \"dimensions\": \"12 × 10 inches\",\n  \"weight\": \"650 grams\",\n  \"images\": [\n    \"https://images.unsplash.com/photo-1578749556568-bc2c40e68b61?w=600\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            }
          }
        },
        {
          "name": "List Artisan's Own Products",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{artisanToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            }
          }
        },
        {
          "name": "Get Single Owned Product Detail",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{artisanToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "1"]
            }
          }
        },
        {
          "name": "Update Product (Stock / Price)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{artisanToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 1950,\n  \"quantity\": 25\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "1"]
            }
          }
        },
        {
          "name": "Publish to External Marketplaces",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{artisanToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"marketplaces\": [\"ONDC\", \"GEM\", \"AMAZON_SAHELI\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products/1/publish",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "1", "publish"]
            }
          }
        },
        {
          "name": "Get Product Marketplace Sync Status",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{artisanToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products/1/marketplaces",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "1", "marketplaces"]
            }
          }
        }
      ]
    },
    {
      "name": "05. Product Discovery (Buyer)",
      "item": [
        {
          "name": "Search Products (Public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/marketplace/search?q=pottery&category=pottery&minPrice=500&maxPrice=5000&page=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "marketplace", "search"],
              "query": [
                { "key": "q", "value": "pottery" },
                { "key": "category", "value": "pottery" },
                { "key": "minPrice", "value": "500" },
                { "key": "maxPrice", "value": "5000" },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Public Product Detail (With GI Specs)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/marketplace/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "marketplace", "products", "1"]
            }
          }
        },
        {
          "name": "Get Artisan Public Storefront",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/public/stores/ramesh-kumar-1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "public", "stores", "ramesh-kumar-1"]
            }
          }
        },
        {
          "name": "Get Storefront QR Code",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/public/stores/ramesh-kumar-1/qr.png",
              "host": ["{{baseUrl}}"],
              "path": ["api", "public", "stores", "ramesh-kumar-1", "qr.png"]
            }
          }
        }
      ]
    },
    {
      "name": "06. Order Management",
      "item": [
        {
          "name": "Buyer Place Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": 1,\n  \"quantity\": 2,\n  \"deliveryAddress\": \"Flat 402, Lotus Heights, Bengaluru 560038\",\n  \"notes\": \"Fragile item, please pack with double bubble wrap.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "Buyer Past Orders",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/buyer",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "buyer"]
            }
          }
        },
        {
          "name": "Artisan Received Orders",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{artisanToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "Get Order Detail & Milestones",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "1"]
            }
          }
        },
        {
          "name": "Artisan Update Fulfillment Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{artisanToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PRODUCTION\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders/1/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "1", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "07. AI Pricing & Market Intelligence",
      "item": [
        {
          "name": "Estimate Product Price (AI + Tavily Live Search)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Chanderi Silk Handloom Saree\",\n  \"category\": \"textile\",\n  \"material\": \"Pure Silk and Zari\",\n  \"hoursSpent\": 36,\n  \"materialCost\": 2800\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/pricing/estimate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pricing", "estimate"]
            }
          }
        }
      ]
    },
    {
      "name": "08. B2B Inquiries & Custom Requests",
      "item": [
        {
          "name": "Submit Public B2B Inquiry",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"artisanId\": 1,\n  \"productId\": 1,\n  \"buyerName\": \"Pooja Mehta\",\n  \"buyerPhone\": \"+919811223344\",\n  \"quantity\": 50,\n  \"targetPrice\": 1500,\n  \"message\": \"Looking for bulk corporate festive gifting supply.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/public/inquiries",
              "host": ["{{baseUrl}}"],
              "path": ["api", "public", "inquiries"]
            }
          }
        },
        {
          "name": "Artisan List Inquiries",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{artisanToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/artisan/inquiries",
              "host": ["{{baseUrl}}"],
              "path": ["api", "artisan", "inquiries"]
            }
          }
