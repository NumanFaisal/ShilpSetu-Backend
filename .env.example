# ============================================================
# ShilpSetu Backend — Environment Variables
# ============================================================
# Copy this file to `.env` and fill in your real credentials.
#   cp .env.example .env
#
# Variables marked [REQUIRED] will cause the server to refuse
# to start if they are missing or empty.
# Variables marked [OPTIONAL] have safe defaults or graceful
# fallback behaviour when absent.
# ============================================================

# ── Server ──────────────────────────────────────────────────
# [OPTIONAL] Runtime environment. Default: development
NODE_ENV=development

# [OPTIONAL] HTTP port the server listens on. Default: 4000
PORT=5001

# [OPTIONAL] Allowed CORS origin for the web frontend.
FRONTEND_URL=http://localhost:3000

# [REQUIRED in prod] HS256 secret used to sign JWT tokens.
# Generate a secure random value: openssl rand -hex 64
JWT_SECRET=change-me-to-a-strong-random-secret-at-least-32-chars

# ── Database (PostgreSQL ≥ 15) ───────────────────────────────
# [REQUIRED] Full PostgreSQL connection string.
# Docker default (matches docker-compose.yml):
DATABASE_URL=postgresql://shilpsetu:shilpsetu@localhost:5433/shilpsetu

# ── Redis (BullMQ job queues) ────────────────────────────────
# Provide either REDIS_URL (takes priority) or HOST+PORT+PASSWORD.
# Docker default port is 6380 (mapped from container's 6379).
#
# [OPTIONAL] Full redis:// URL — overrides HOST/PORT/PASSWORD below.
# REDIS_URL=redis://default:password@localhost:6380

# [OPTIONAL] Redis host. Default: localhost
REDIS_HOST=localhost

# [OPTIONAL] Redis port. Default: 6380
REDIS_PORT=6380

# [OPTIONAL] Redis password (leave blank for no-auth local dev).
# REDIS_PASSWORD=

# ── Cloudflare R2 (Image / File Storage) ────────────────────
# Create a bucket at: https://dash.cloudflare.com/ → R2 Object Storage
# Then generate an API token with Object Read & Write permissions.
#
# [REQUIRED] Your Cloudflare Account ID (found on R2 dashboard).
R2_ACCOUNT_ID=your-cloudflare-account-id

# [REQUIRED] R2 API token Access Key ID.
R2_ACCESS_KEY_ID=your-r2-access-key-id

# [REQUIRED] R2 API token Secret Access Key.
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# [REQUIRED] Name of the R2 bucket to store images.
R2_BUCKET_NAME=shilpsetu-images

# [OPTIONAL] Public CDN URL for the R2 bucket (e.g. a custom domain
# or the r2.dev subdomain). Omit trailing slash.
# R2_PUBLIC_URL=https://images.yourdomain.com

# ── AI Providers ─────────────────────────────────────────────
# At least one AI key should be set for image analysis & catalog
# generation. The pipeline tries providers in priority order.

# [OPTIONAL] Google Gemini API key — used for product analysis,
# image segmentation fallback, and catalog text generation.
# Get it at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# [OPTIONAL] OpenAI API key — used as secondary AI provider for
# image enhancement prompts and catalog generation.
# Get it at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# [OPTIONAL] Groq API key — ultra-fast LLM inference for catalog
# generation (llama-3 models). Free tier available.
# Get it at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# [OPTIONAL] Tavily Search API key — enables live market price
# lookups for the pricing engine. Without this key, pricing falls
# back to static craft benchmarks (pricingSource: 'benchmark_fallback').
# Get it at: https://app.tavily.com
TAVILY_API_KEY=your-tavily-api-key

# ── Background Removal (Poof.bg) ─────────────────────────────
# Poof.bg is the Tier-1 background removal engine (~100ms per image).
# Without this key the pipeline falls back to Gemini Vision polygon
# segmentation, then to local flood-fill segmentation.
#
# [OPTIONAL] Poof.bg API key.
# Get it at: https://poof.bg (sign up → API tab)
POOF_BG_API_KEY=your-poof-bg-api-key

# [OPTIONAL] Poof.bg endpoint. Default is the v1 remove endpoint.
POOF_BG_API_URL=https://api.poof.bg/v1/remove

# ── Security ─────────────────────────────────────────────────
# [OPTIONAL] AES-256-GCM key for encrypting marketplace tokens
# stored in the database. Must be exactly 32 bytes (64 hex chars).
# Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=change-me-to-a-64-hex-char-aes256-key

# ── Admin Bootstrap ───────────────────────────────────────────
# If set, running `npm run seed:admin` will create an admin account
# with these credentials. Leave blank to skip admin seeding.
#
# [OPTIONAL] Admin account phone number (e.g. +919876543210)
# ADMIN_PHONE=+91XXXXXXXXXX

# [OPTIONAL] Admin account password (min 8 chars recommended)
# ADMIN_PASSWORD=change-me-strong-password
