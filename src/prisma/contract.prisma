// use prisma-next

model User {
  id           Int      @id @default(autoincrement())
  name         String
  phone        String   @unique
  passwordHash String
  role         String   @default("user")
  language     String   @default("en")
  createdAt    DateTime @default(now())
  artisan      Artisan?
  batches      ImageBatch[]
}

model Artisan {
  id         Int    @id @default(autoincrement())
  userId     Int    @unique
  user       User   @relation(fields: [userId], references: [id])
  location   String
  state      String
  district   String
  craftType  String
  experience Int?
  products   Product[]
}

model Product {
  id          Int      @id @default(autoincrement())
  artisanId   Int
  artisan     Artisan  @relation(fields: [artisanId], references: [id])
  name        String
  category    String?
  material    String?
  description String?
  price       Float?
  quantity    Int      @default(0)
  status      String   @default("draft")
  createdAt   DateTime @default(now())

  images      ProductImage[]
  voiceInputs VoiceInput[]
  catalogue   Catalogue?
  pricing     Pricing?
  inquiries   B2BInquiry[]
  orders      Order[]
}

model ImageBatch {
  id              String   @id @default(uuid())
  userId          Int
  user            User     @relation(fields: [userId], references: [id])
  style           String   @default("white_studio")
  productId       Int?
  status          String   @default("PENDING")
  totalImages     Int      @default(0)
  completedImages Int      @default(0)
  failedImages    Int      @default(0)
  error           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())

  images          ProductImage[]
}

model ProductImage {
  id                  String    @id @default(uuid())
  batchId             String
  batch               ImageBatch @relation(fields: [batchId], references: [id])
  productId           Int?
  product             Product?  @relation(fields: [productId], references: [id])
  originalKey         String
  cutoutKey           String?
  cleanedKey          String?
  studioKey           String?
  lightingKey         String?
  shadowKey           String?
  compositionKey      String?
  outputSquareKey     String?
  outputPortraitKey   String?
  outputLandscapeKey  String?
  status              String    @default("QUEUED")
  currentStep         String?
  progress            Int       @default(0)
  error               String?
  analysis            String?
  boundingBox         String?
  validationScore     Float?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now())

  versions            ImageVersion[]
}

model ImageVersion {
  id              String   @id @default(uuid())
  imageId         String
  image           ProductImage @relation(fields: [imageId], references: [id])
  processingStep  String
  storageKey      String
  width           Int?
  height          Int?
  format          String?
  metadata        String?
  createdAt       DateTime @default(now())
}

model AILog {
  id          String   @id @default(uuid())
  batchId     String?
  imageId     String?
  provider    String
  model       String
  operation   String
  attempt     Int      @default(1)
  durationMs  Int
  success     Boolean
  costEstimate Float  @default(0)
  error       String?
  createdAt   DateTime @default(now())
}

model VoiceInput {
  id         Int     @id @default(autoincrement())
  productId  Int
  product    Product @relation(fields: [productId], references: [id])
  audioUrl   String
  language   String?
  transcript String?
}

model Catalogue {
  id                Int     @id @default(autoincrement())
  productId         Int     @unique
  product           Product @relation(fields: [productId], references: [id])
  titleEn           String?
  titleHi           String?
  descriptionEn     String?
  descriptionHi     String?
  keywords          String[]
  careInstructions  String?
}

model Pricing {
  id                Int     @id @default(autoincrement())
  productId         Int     @unique
  product           Product @relation(fields: [productId], references: [id])
  materialCost      Float?
  laborCost         Float?
  minimumPrice      Float?
  marketMin         Float?
  marketMax         Float?
  recommendedPrice  Float?
}

model B2BInquiry {
  id               Int      @id @default(autoincrement())
  buyerId          Int
  artisanId        Int
  productId        Int
  product          Product  @relation(fields: [productId], references: [id])
  quantity         Int
  targetPrice      Float?
  deliveryLocation String?
  requiredDate     DateTime?
  message          String?
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())
}

model Order {
  id          Int      @id @default(autoincrement())
  buyerId     Int
  artisanId   Int
  productId   Int
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  totalAmount Float
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
}
